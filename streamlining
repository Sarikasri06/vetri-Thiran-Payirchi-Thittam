/*
 * Project: Standard Laptop Order Automation
 * Platform: ServiceNow
 * Purpose: Validate standard laptop requests
 */

function validateLaptopRequest(request) {
    if (!request || !request.requester) {
        return {
            valid: false,
            message: "Requester is required."
        };
    }

    if (!request.laptopType) {
        return {
            valid: false,
            message: "Laptop type is required."
        };
    }

    if (request.laptopType !== "standard") {
        return {
            valid: false,
            message: "Only standard laptop orders are supported."
        };
    }

    return {
        valid: true,
        message: "Request is ready for approval.",
        status: "Pending Approval"
    };
}

// Example test
var result = validateLaptopRequest({
    requester: "employee@example.com",
    laptopType: "standard"
});

console.log(result);
